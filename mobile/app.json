{
  "expo": {
    "name": "Asset Tracker",
    "icon": "./assets/AssetLogo.png",
    "slug": "cadbury-visi-cooler-tracker",
    "version": "0.1.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/e128298f-dd7e-40c1-81be-23edbc27491e"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/AssetLogo.png",
          "imageWidth": 155,
          "resizeMode": "contain",
          "backgroundColor": "#F8F5FA"
        }
      ],
      "expo-location",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["arm64-v8a"],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "usesCleartextTraffic": false
          }
        }
      ]
    ],
    "android": {
      "package": "com.visicooler.tracker",
      "softwareKeyboardLayoutMode": "pan",
      "allowBackup": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "e128298f-dd7e-40c1-81be-23edbc27491e"
      }
    },
    "owner": "arpitr18",
    "ios": {}
  }
}
